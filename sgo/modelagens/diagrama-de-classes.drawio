        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\npackage \&quot;Entidades Principais\&quot; {\n    class Competicao {\n        - id: int\n        - nomeModalidade: String\n        - data: Date\n        - horario: String\n        - local: Local\n        - atletas: List&lt;Atleta&gt;\n        - resultado: Resultado\n    }\n\n    class Atleta {\n        - id: int\n        - nome: String\n        - pais: Pais\n        - modalidades: List&lt;String&gt;\n    }\n\n    class Local {\n        - id: int\n        - nome: String\n        - endereco: String\n        - capacidade: int\n    }\n\n    class Resultado {\n        - id: int\n        - primeiroLugar: Atleta\n        - segundoLugar: Atleta\n        - terceiroLugar: Atleta\n    }\n\n    class Pais {\n        - id: int\n        - nome: String\n        - medalhasOuro: int\n        - medalhasPrata: int\n        - medalhasBronze: int\n    }\n}\n\npackage \&quot;Serviços\&quot; {\n    class ServicoCompeticao\n    class ServicoAtleta\n    class ServicoRelatorio\n}\n\nCompeticao \&quot;1\&quot; --&gt; \&quot;1\&quot; Local\nCompeticao \&quot;1\&quot; --&gt; \&quot;*\&quot; Atleta\nCompeticao \&quot;1\&quot; --&gt; \&quot;1\&quot; Resultado\nAtleta \&quot;*\&quot; --&gt; \&quot;1\&quot; Pais\nServicoCompeticao --&gt; Competicao\nServicoAtleta --&gt; Atleta\nServicoRelatorio --&gt; Pais\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="qmPYTHthZ5xl_O3csSI4-1">
